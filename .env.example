# =====================
# MERCCAHOTEL WHATSAPP BOT
# Copia este archivo como .env y completa los valores
# NUNCA subas .env a GitHub
# =====================

# WhatsApp Cloud API (Meta)
# Obtener en: developers.facebook.com → tu app → WhatsApp → API Setup
WA_TOKEN=tu_token_de_whatsapp_aqui
WA_PHONE_ID=tu_phone_id_aqui

# Token de verificación del webhook (puedes inventarlo tú)
VERIFY_TOKEN=merccahotel_webhook_2026

# Puerto del servidor
PORT=3000

# =====================
# FASE 2 — Paximum (descomentar cuando tengas credenciales)
# =====================
# PAXIMUM_USERNAME=tu_usuario_paximum
# PAXIMUM_PASSWORD=tu_password_paximum
# PAXIMUM_API_URL=https://api.paximum.com

# =====================
# FASE 3 — Webbeds (cuando se integre)
# =====================
# WEBBEDS_API_KEY=
# WEBBEDS_API_URL=
